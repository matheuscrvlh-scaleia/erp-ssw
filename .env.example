# Variáveis do docker-compose.yml (produção). Copie para .env na raiz e preencha. Nada aqui é segredo.
# Domínio, e-mail (Resend) e worker-ssw ficam na tela Plataforma › Integrações (cifrados no banco).

# Papel erp_app (sem BYPASSRLS). CA do Supabase em certs/supabase-ca.crt:
#   ...?sslmode=verify-full&sslrootcert=/etc/erp/certs/supabase-ca.crt
DATABASE_URL=postgres://erp_app:SENHA@HOST:5432/postgres

# Ed25519 PKCS8 PEM numa linha com \n literal (aspas simples). O kid sai da própria chave.
JWT_CHAVE_PRIVADA=

# Chave mestra "1:<base64 de 32 bytes>": cifra os segredos das integrações e deriva o segredo do
# cookie. A MESMA no .env do worker-ssw. Gerar: echo "1:$(openssl rand -base64 32)"
SEGREDOS_CHAVES=

# Opcionais: API_PORTA_HOST (3001), WEB_PORTA_HOST (8081), API_DB_MAX_CONEXOES (10), LOG_NIVEL,
# JOBS_LIGADOS (true), AGENDAMENTOS_LIGADOS (false), GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI.
