# Variáveis do docker-compose.yml (produção). Copie para .env na raiz e preencha. Nada aqui é segredo.
# Domínio, e-mail (Resend) e worker-ssw ficam na tela Plataforma › Integrações (cifrados no banco).

# Postgres do compose. Senhas: openssl rand -hex 24 (sem símbolo, entram na URL). As ERP_*_SENHA só
# valem na 1ª subida (volume vazio); depois, trocar senha é ALTER ROLE (docs/deploy.md §4).
POSTGRES_SENHA=
ERP_MIGRACAO_SENHA=
ERP_APP_SENHA=
ERP_WORKER_SENHA=

# Papel erp_app (sem BYPASSRLS) com a ERP_APP_SENHA acima. Rede interna do Docker, sem TLS.
DATABASE_URL=postgres://erp_app:SENHA@postgres:5432/postgres

# Ed25519 PKCS8 PEM numa linha com \n literal (aspas simples). O kid sai da própria chave.
JWT_CHAVE_PRIVADA=

# Chave mestra "1:<base64 de 32 bytes>": cifra os segredos das integrações. A MESMA no .env do
# worker-ssw. Gerar: echo "1:$(openssl rand -base64 32)"
SEGREDOS_CHAVES=

# Opcionais: API_PORTA_HOST (3001), WEB_PORTA_HOST (8081), API_DB_MAX_CONEXOES (10), LOG_NIVEL,
# JOBS_LIGADOS (true), AGENDAMENTOS_LIGADOS (false), POSTGRES_PORTA_HOST (5432, só 127.0.0.1),
# BACKUP_PASTA (./backups), BACKUP_DIAS (7).
