# Variáveis do docker-compose.yml (produção). Copie para .env na raiz e preencha. Nada aqui é segredo.
# Desenvolvimento usa apps/api/.env (modelo em apps/api/.env.example).

# Domínio público (a api monta links de e-mail e o retorno do Google com ele).
DOMINIO=erp.exemplo.com.br
# Portas do host (contêiner: api 3000, web 80).
API_PORTA_HOST=3001
WEB_PORTA_HOST=8081

# Papel erp_app (sem BYPASSRLS). CA do Supabase em certs/supabase-ca.crt:
#   ...?sslmode=verify-full&sslrootcert=/etc/erp/certs/supabase-ca.crt
DATABASE_URL=postgres://erp_app:SENHA@HOST:5432/postgres
API_DB_MAX_CONEXOES=10
API_DB_TIMEOUT_CONSULTA_MS=30000
LOG_NIVEL=info
CORS_ORIGENS=

# Ed25519 PKCS8 PEM numa linha com \n literal (aspas simples).
JWT_CHAVE_PRIVADA=
JWT_KID=2026-11
# 32+ caracteres aleatórios.
COOKIE_SEGREDO=

SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
EMAIL_REMETENTE=Painel Logístico <nao-responda@exemplo.com.br>

# versão:base64 de 32 bytes, separadas por vírgula.
SEGREDOS_CHAVES=
SEGREDOS_CHAVE_ATUAL=1

JOBS_LIGADOS=true
AGENDAMENTOS_LIGADOS=false

# HTTP interno do worker-ssw pela rede erp-interna; sem eles as ações de ingestão respondem 503.
# WORKER_SSW_URL=http://worker-ssw:3000
# WORKER_SSW_TOKEN=
