# infra/.env da VPS — modelo SEM valores. Copie para infra/.env (dono: usuário deploy,
# chmod 600), preencha e nunca comite. O compose interpola daqui e entrega a cada serviço só o
# que ele usa (lista em compose.yaml). Runbook: docs/deploy.md.
#
# Opcional que não for usado fica COMENTADO: vazio vira "" no contêiner e a validação do boot
# recusa (ex.: GOOGLE_REDIRECT_URI vazio não é URL).

# ---------- Borda (Caddy) --------------------------------------------------------------------
# Domínio do sistema (registro A/AAAA apontando para a VPS antes do primeiro `up`).
DOMINIO=
# E-mail da conta ACME (avisos do Let's Encrypt).
ACME_EMAIL=
# Content-Security-Policy (padrão) ou Content-Security-Policy-Report-Only (só observar).
CSP_CABECALHO=Content-Security-Policy
# Origem dos logos (a de LOGO_URL_BASE, ex.: https://<bucket>.s3.<regiao>.amazonaws.com). Entra
# na CSP (img-src). Sem logos, deixe comentado.
# LOGO_ORIGEM=
# Tetos de corpo na borda, em MiB: IGUAIS ao bodyLimit da API (maior que o dela vira 502 no
# cliente; docs/deploy.md §1.1). /api/public/* (worker-ssw) com arquivo base64: 64; /api/*: 1.
LIMITE_CORPO_PUBLICO_MB=64
LIMITE_CORPO_API_MB=1
# host:porta do HTTP público do worker-ssw na rede erp-interna.
WORKER_SSW_PUBLICO=worker-ssw:3000
# Portas publicadas (só mudam em teste local).
PORTA_HTTP=80
PORTA_HTTPS=443
# api e web publicadas direto no host (contêiner: 3000 e 80).
API_PORTA_HOST=3001
WEB_PORTA_HOST=8081

# ---------- Capacidade -----------------------------------------------------------------------
API_CPUS=1.5
API_MEMORIA=768M
# Conexões por réplica. Total no Postgres = API_DB_MAX_CONEXOES (uma réplica) + as do
# worker-ssw (o compose dele) (+1 do migrador): caber no pool do Supabase (docs/deploy.md §4.1).
API_DB_MAX_CONEXOES=10

# ---------- Banco (Postgres do Supabase) -----------------------------------------------------
# Papel erp_app (sem BYPASSRLS), pelo pooler em modo sessão, com TLS verificado:
# postgres://erp_app.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/erp/certs/supabase-ca.crt
DATABASE_URL=
# Papel erp_migracao (dono do schema erp). Só o migrador recebe.
DATABASE_URL_MIGRACAO=
API_DB_TIMEOUT_CONSULTA_MS=30000

# ---------- Redis (BullMQ + limite de taxa) --------------------------------------------------
# Hex (openssl rand -hex 32): vai dentro da URL redis://:<senha>@redis, sem caractere especial.
REDIS_SENHA=

# ---------- API ------------------------------------------------------------------------------
LOG_NIVEL=info
# Origens extras do CORS, separadas por vírgula (a do DOMINIO já entra).
CORS_ORIGENS=
# Ed25519 em PKCS8 PEM, numa linha, com \n literal e aspas simples (docs/deploy.md §5.1).
JWT_CHAVE_PRIVADA=
# Identificador da chave atual (ex.: 2026-11). Muda a cada rotação.
JWT_KID=
# Chaves públicas anteriores durante a rotação: '{"<kid>":"<PEM público>"}'.
# JWT_CHAVES_ANTERIORES=
# REFRESH_DIAS=30
# 32+ caracteres aleatórios (openssl rand -base64 48). Assina o cookie do login pelo Google.
COOKIE_SEGREDO=

# E-mail (convite, esqueci minha senha). Obrigatório em produção.
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_SENHA=
EMAIL_REMETENTE=

# Login pelo Google (opcional; as três juntas). URI: https://<DOMINIO>/api/v1/auth/google/retorno
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Base pública dos logos (bucket S3). Opcional.
# LOGO_URL_BASE=
# Token de leitura de /metrics (só pela rede interna; a borda devolve 404). Opcional.
# METRICAS_TOKEN=

# ---------- Segredos de integração (AES-256-GCM, packages/db/src/segredos.ts) ----------------
# Chaves mestras "versão:base64 de 32 bytes" separadas por vírgula, e a versão atual. As MESMAS
# no .env do worker-ssw (ele lê o que a API cifra); ver docs/deploy.md §5.3.
SEGREDOS_CHAVES=
SEGREDOS_CHAVE_ATUAL=

# ---------- Jobs do ERP (na API) -------------------------------------------------------------
# Workers do BullMQ nas réplicas da API (limpar sessões, prazos, classificação de códigos,
# recifrar segredos). Várias réplicas não duplicam job.
JOBS_LIGADOS=true
# Liga os jobs agendados do ERP. false até a virada (docs/deploy.md §10).
AGENDAMENTOS_LIGADOS=false

# ---------- worker-ssw (HTTP interno, ADR 0012) ----------------------------------------------
# Base do HTTP interno pela rede erp-interna e o token de serviço (um dos INTERNO_TOKENS do
# worker-ssw; openssl rand -hex 32). Sem os dois, as ações das telas de ingestão respondem 503.
# WORKER_SSW_URL=http://worker-ssw:3000
# WORKER_SSW_TOKEN=
