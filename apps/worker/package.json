{
  "name": "@erp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jobs BullMQ (ingestão, projeções e agendamentos por empresa).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@erp/db": "workspace:*",
    "@erp/dominio": "workspace:*",
    "@erp/shared": "workspace:*",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.0",
    "pino": "^9.11.0"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5"
  }
}
