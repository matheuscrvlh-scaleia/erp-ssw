# Worker (BullMQ). Copie para .env e preencha. Nada aqui é segredo real.
NODE_ENV=development
LOG_NIVEL=info
# Papel erp_app (sem BYPASSRLS) no Supabase DEVELOP, schema erp.
DATABASE_URL=postgres://erp_app:SENHA@HOST:5432/postgres
DB_MAX_CONEXOES=5
DB_TIMEOUT_CONSULTA_MS=120000
REDIS_URL=redis://127.0.0.1:6379
PORTA_SAUDE=3002
# Agendamentos repetíveis (cron). Desligados por padrão: ligar só no ambiente que deve rodar.
AGENDAMENTOS_LIGADOS=false
# Jobs de ingestão ligados no agendador (separados por vírgula), ex.: bi2_0017,ssw_token_check.
# Vazio = nenhum. O webhook (ssw_webhook) não depende disto: roda quando a API enfileira.
INGESTAO_JOBS_LIGADOS=
# Chaves mestras dos segredos de integração (as mesmas da API) e a versão atual.
SEGREDOS_CHAVES=
SEGREDOS_VERSAO_ATUAL=1
