# API (Fastify). Copie para .env e preencha. Nada aqui é segredo real.
NODE_ENV=development
HOST=0.0.0.0
PORTA=3001
LOG_NIVEL=info
# Proxies (Caddy) na frente da API; 0 em desenvolvimento.
PROXIES_CONFIAVEIS=0

# Papel erp_app (sem BYPASSRLS) no Supabase erp-ssw (phjsyaeeklnzkxzdmrmn), schema erp.
DATABASE_URL=postgres://erp_app:SENHA@HOST:5432/postgres
DB_MAX_CONEXOES=10
DB_TIMEOUT_CONSULTA_MS=30000
# Sem REDIS_URL (só desenvolvimento) o limite de taxa fica na memória. Redis local: docker compose up -d redis.
REDIS_URL=redis://127.0.0.1:6379

WEB_URL=http://localhost:5173
# Origens extras do CORS, separadas por vírgula.
CORS_ORIGENS=

# Chave Ed25519 (PKCS8 PEM; \n literal aceito). Gerar com:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
JWT_CHAVE_PRIVADA=
# PEM públicos anteriores (rotação), em lista JSON: ["<PEM público>"]. O kid sai de cada chave.
JWT_CHAVES_ANTERIORES=
REFRESH_DIAS=30

# Domínio, e-mail (Resend) e worker-ssw ficam em Plataforma › Integrações. Sem e-mail configurado,
# em desenvolvimento a mensagem sai no log.

# Login pelo Google (opcional; as três juntas). A URI de volta passa pelo web (mesma origem).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/retorno

# Base pública dos logos das empresas (bucket S3). Opcional.
LOGO_URL_BASE=
# Bucket S3 compatível dos logos (as três juntas). S3_ENDPOINT só para MinIO/R2/etc.
S3_ENDPOINT=
S3_REGIAO=us-east-1
S3_BUCKET=
S3_CHAVE_ACESSO=
S3_SEGREDO=
S3_CAMINHO_NO_ESTILO=false

# Token para ler /metrics (Prometheus). Sem ele, a rota não existe.
METRICAS_TOKEN=

# Chave mestra (AES-256-GCM): versão:base64 de 32 bytes, separadas por vírgula. Cifra os segredos
# das integrações e deriva o segredo do cookie. Gerar com:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
SEGREDOS_CHAVES=
# Versão usada para cifrar segredos novos (padrão: a maior).
# SEGREDOS_CHAVE_ATUAL=
# Transição: credencial do Ahgora no ambiente, usada só pela empresa com parametros.usar_env.
AHGORA_API_USUARIO=
AHGORA_API_SENHA=
