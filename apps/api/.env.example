# API (Fastify). Copie para .env e preencha. Nada aqui é segredo real.
NODE_ENV=development
HOST=0.0.0.0
PORTA=3001
LOG_NIVEL=info
# Proxies (Caddy) na frente da API; 0 em desenvolvimento.
PROXIES_CONFIAVEIS=0

# Papel erp_app (sem BYPASSRLS) no Supabase DEVELOP, schema erp. Nunca o projeto de produção.
DATABASE_URL=postgres://erp_app:SENHA@HOST:5432/postgres
DB_MAX_CONEXOES=10
DB_TIMEOUT_CONSULTA_MS=30000
# Sem REDIS_URL (só desenvolvimento) o limite de taxa fica na memória. Ver docker-compose.dev.yml.
REDIS_URL=redis://127.0.0.1:6379

WEB_URL=http://localhost:5173
# Origens extras do CORS, separadas por vírgula.
CORS_ORIGENS=

# Chave Ed25519 (PKCS8 PEM; \n literal aceito). Gerar com:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
JWT_CHAVE_PRIVADA=
JWT_KID=2026-11
# Chaves públicas anteriores (rotação): {"<kid>":"<PEM público>"}
JWT_CHAVES_ANTERIORES=
REFRESH_DIAS=30
# 32+ caracteres aleatórios (assina o cookie do login pelo Google).
COOKIE_SEGREDO=

# Sem SMTP_HOST em desenvolvimento, o e-mail sai no log.
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=Painel Logístico <nao-responda@exemplo.com.br>

# Login pelo Google (opcional; as três juntas). A URI de volta passa pelo web (mesma origem).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/retorno

# Base pública dos logos das empresas (bucket S3). Opcional.
LOGO_URL_BASE=
# Token para ler /metrics (Prometheus). Sem ele, a rota não existe.
METRICAS_TOKEN=

# Segredos de integração (AES-256-GCM): versão:base64 de 32 bytes, separadas por vírgula. Gerar com:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
SEGREDOS_CHAVES=
SEGREDOS_CHAVE_ATUAL=1
# Transição: credencial do Ahgora no ambiente, usada só pela empresa com parametros.usar_env.
AHGORA_API_USUARIO=
AHGORA_API_SENHA=
