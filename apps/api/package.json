{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP (Fastify 5).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@erp/db": "workspace:*",
    "@erp/dominio": "workspace:*",
    "@erp/ingestao": "workspace:*",
    "@erp/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/under-pressure": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.6",
    "openid-client": "^6.8.0",
    "prom-client": "^15.1.3",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/nodemailer": "^7.0.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5"
  }
}
