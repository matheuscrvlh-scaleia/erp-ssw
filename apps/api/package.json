{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP (Fastify 5) e os jobs do ERP (BullMQ). Projeto independente: dependências, lint e testes próprios.",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrar": "node --env-file-if-exists=.env --import tsx src/db/migrar.ts",
    "db:semear": "node --env-file-if-exists=.env --import tsx src/db/seeds/executar.ts"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/under-pressure": "^9.0.3",
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
