{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,

    // @erp/shared e @erp/dominio são copiados para o web e o worker-ssw com os mesmos imports: o
    // arquivo fica igual nas cópias. Aqui @erp/shared mora em views/contratos, views/contrato.ts e
    // models/comum (scripts/copiar-compartilhado.sh). tsx e esbuild leem estes mesmos caminhos.
    "paths": {
      "@erp/dominio/nucleo": ["./src/dominio/nucleo/index.ts"],
      "@erp/dominio/ingestao/relatorios": ["./src/dominio/ingestao/relatorios/index.ts"],
      "@erp/dominio/*": ["./src/dominio/*"],
      "@erp/shared/contratos/*": ["./src/views/contratos/*"],
      "@erp/shared/contrato": ["./src/views/contrato.ts"],
      "@erp/shared/*": ["./src/models/comum/*"],
      "@erp/db": ["./src/db/index.ts"],
      "@erp/db/schema": ["./src/db/schema/index.ts"],
      "@erp/db/segredos": ["./src/db/segredos.ts"],
      "@erp/db/seeds": ["./src/db/seeds/catalogo.ts"]
    }
  },
  "include": ["src", "drizzle.config.ts"]
}
